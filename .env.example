# Copy this file to .env and replace the placeholder values.
# Do not commit or share .env.

# Local image name. Later this can be changed to a Docker Hub or GHCR image.
IMAGE_NAME=giovan/jupyter-gpu:cu128

# Cloudflare Tunnel image. Pin a tested version for a reproducible deployment.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Obtain with: tailscale ip -4
TAILSCALE_IP=CHANGE_ME

# Numeric owner used for bind-mounted files. Obtain with: id -u; id -g
NB_UID=1000
NB_GID=1000

# These directories must exist before Compose starts. Keep the workspace,
# general data, and Codex credential state as separate directory trees.
WORKSPACE_ROOT=./workspace
DATA_ROOT=./data
CODEX_ROOT=./state/codex

# Generate locally with: openssl rand -hex 32
JUPYTER_TOKEN=CHANGE_ME_GENERATE_AND_REPLACE

# File containing the remotely-managed Cloudflare Tunnel token.
# This path must not be inside WORKSPACE_ROOT or DATA_ROOT.
# Set its host owner/group to NB_UID:NB_GID and its mode to 0640. Compose gives
# the non-root cloudflared process supplementary access to NB_GID.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token
